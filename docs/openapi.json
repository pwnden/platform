{
  "openapi": "3.1.2",
  "info": {
    "title": "pwnden local player API",
    "version": "1.6.0",
    "description": "Local player API implemented by the Go server and serve command."
  },
  "servers": [{"url": "/api/v1"}],
  "security": [{"LocalSession": []}],
  "paths": {
    "/problems/{slug}/workspace": {
      "parameters": [{"$ref": "#/components/parameters/Slug"}],
      "get": {
        "operationId": "watchProblemWorkspace",
        "summary": "Prepare and retain a visible problem without opening a terminal",
        "description": "Bearer-authenticated NDJSON stream. The first line is a ready message with Status; heartbeat lines follow every 20 seconds. A disconnected last viewer starts ten-minute expiry unless a terminal is attached. Multiple viewers share one environment; the per-server environment limit is ten. No PTY or toolbox is created for a view. An error line terminates an invalidated view.",
        "responses": {
          "200": {"description": "NDJSON ready, heartbeat and error messages", "content": {"application/x-ndjson": {"schema": {"type": "string"}}}},
          "default": {"$ref": "#/components/responses/Failure"}
        }
      }
    },
    "/problems/{slug}/browser": {
      "parameters": [{"$ref": "#/components/parameters/Slug"}],
      "post": {
        "operationId": "openProblemBrowser",
        "summary": "Open the common browser for a running declared HTTP endpoint",
        "description": "Bearer-authenticated JSON name only, up to 4096 bytes. The platform selects a declared HTTP service in the current isolated environment and returns its owned loopback browser wrapper. Fixed-destination Docker streams provide ingress. Repeated opens reuse the endpoint wrapper. Workspace expiry and server shutdown close listeners. Problem documents and security headers are preserved.",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "required": ["name"], "properties": {"name": {"type": "string", "minLength": 1}}}}}},
        "responses": {
          "200": {"description": "Common browser prepared", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Browser"}}}},
          "default": {"$ref": "#/components/responses/Failure"}
        }
      }
    },
    "/workspaces": {
      "get": {
        "operationId": "listWorkspaces",
        "summary": "List this server's retained problem environments",
        "responses": {
          "200": {"description": "Retained environments and policy", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/WorkspaceList"}}}},
          "default": {"$ref": "#/components/responses/Failure"}
        }
      }
    },
    "/problems/{slug}/terminal": {
      "parameters": [{"$ref": "#/components/parameters/Slug"}],
      "get": {
        "operationId": "connectTerminal",
        "summary": "Upgrade to the interactive toolbox terminal",
        "description": "Same-origin Origin and pwnden.terminal.v2 subprotocol required. Authenticate in the first WebSocket text frame within five seconds, before resource creation. Prepares stopped services and attaches to the retained shell; disconnect starts the ten-minute inactivity timer. Frames and ownership are documented in terminal.md.",
        "security": [],
        "x-websocket-subprotocol": "pwnden.terminal.v2",
        "responses": {
          "101": {"description": "WebSocket upgraded; first-frame authentication still required"},
          "default": {"$ref": "#/components/responses/Failure"}
        }
      },
      "delete": {
        "operationId": "endTerminal",
        "summary": "Remove the retained toolbox while keeping problem services",
        "description": "Bearer-authenticated request with no body; cancels the browser attachment before removing the toolbox. Repeatable cleanup.",
        "responses": {
          "200": {"description": "Terminal removed", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Stop"}}}},
          "default": {"$ref": "#/components/responses/Failure"}
        }
      }
    },
    "/problems": {
      "get": {
        "operationId": "listProblems",
        "summary": "List installed problems in slug order",
        "responses": {
          "200": {
            "description": "Available problem summaries",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ProblemList"}}}
          },
          "default": {"$ref": "#/components/responses/Failure"}
        }
      }
    },
    "/problems/{slug}": {
      "parameters": [{"$ref": "#/components/parameters/Slug"}],
      "get": {
        "operationId": "getProblem",
        "summary": "Read problem metadata, description text and downloadable files",
        "description": "Contract 2 declares the player brief, ordered hints and walkthrough. The detail payload includes the brief plus hint_count and walkthrough availability, without spoiler bodies. Contract 1 retains optional README.md with no guidance. Content is UTF-8 up to 1 MiB. Only declared distribution files are listed; IDs are opaque stable path identifiers.",
        "responses": {
          "200": {"description": "Problem details", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ProblemDetail"}}}},
          "default": {"$ref": "#/components/responses/Failure"}
        }
      }
    },
    "/problems/{slug}/guidance/{id}": {
      "parameters": [{"$ref": "#/components/parameters/Slug"}, {"name": "id", "in": "path", "required": true, "schema": {"type": "string", "pattern": "^(walkthrough|hint-([1-9]|10))$"}}],
      "get": {
        "operationId": "getProblemGuidance",
        "summary": "Read one explicitly requested hint or walkthrough",
        "description": "Bearer-authenticated request with no body. Only declared guidance is available; absent entries return 404. Arbitrary paths are unsupported. The brief does not load this content. Walkthroughs intentionally contain answers.",
        "responses": {
          "200": {"description": "Declared guidance Markdown", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Guidance"}}}},
          "default": {"$ref": "#/components/responses/Failure"}
        }
      }
    },
    "/problems/{slug}/files/{id}": {
      "parameters": [{"$ref": "#/components/parameters/Slug"}, {"name": "id", "in": "path", "required": true, "schema": {"$ref": "#/components/schemas/FileID"}}],
      "get": {
        "operationId": "downloadProblemFile",
        "summary": "Download one declared distribution file",
        "description": "Bearer-authenticated download; no arbitrary file paths. A current distribution ID is required. The body is streamed as an attachment with the original basename.",
        "responses": {
          "200": {
            "description": "Binary attachment",
            "headers": {"Content-Disposition": {"schema": {"type": "string"}}, "Content-Length": {"schema": {"type": "string"}}},
            "content": {"application/octet-stream": {"schema": {"type": "string", "format": "binary"}}}
          },
          "default": {"$ref": "#/components/responses/Failure"}
        }
      }
    },
    "/problems/{slug}/status": {
      "parameters": [{"$ref": "#/components/parameters/Slug"}],
      "get": {
        "operationId": "getProblemStatus",
        "summary": "Observe recorded run state and actual problem containers",
        "description": "File problems are ready without services. Services without a recorded run are stopped. Recorded services are running when every declared service has running containers with healthy or absent health checks; otherwise unavailable. Published endpoints appear only while running. Reads share the mutation lock and never start, stop or erase resources.",
        "responses": {
          "200": {"description": "Observed run status", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Status"}}}},
          "default": {"$ref": "#/components/responses/Failure"}
        }
      }
    },
    "/problems/{slug}/run": {
      "parameters": [{"$ref": "#/components/parameters/Slug"}],
      "post": {
        "operationId": "startProblem",
        "summary": "Start a service problem or select a file problem",
        "description": "No request body. An already recorded service run returns 409 and is preserved. File problems create no service resources.",
        "responses": {
          "200": {
            "description": "Problem ready; published HTTP and TCP entry points retain their original URL scheme",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Run"}}}
          },
          "default": {"$ref": "#/components/responses/Failure"}
        }
      },
      "delete": {
        "operationId": "stopProblem",
        "summary": "Remove problem service resources and saved run state",
        "description": "No request body. Stop is repeatable and reports success only after cleanup completes.",
        "responses": {
          "200": {
            "description": "Problem stopped",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Stop"}}}
          },
          "default": {"$ref": "#/components/responses/Failure"}
        }
      }
    },
    "/problems/{slug}/submissions": {
      "parameters": [{"$ref": "#/components/parameters/Slug"}],
      "post": {
        "operationId": "submitFlag",
        "summary": "Check a candidate flag",
        "description": "The request body is at most 4096 bytes. Incorrect flags are successful checks with accepted=false. Service submissions require a recorded run. No solution is executed or submission history written.",
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SubmissionRequest"}}}
        },
        "responses": {
          "200": {
            "description": "Candidate checked",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Submission"}}}
          },
          "default": {"$ref": "#/components/responses/Failure"}
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "LocalSession": {
        "type": "http",
        "scheme": "bearer",
        "description": "Random token for one local server process; separate from challenge flags. Loopback binding and Host/Origin checks are also required."
      }
    },
    "parameters": {
      "Slug": {
        "name": "slug",
        "in": "path",
        "required": true,
        "schema": {"$ref": "#/components/schemas/Slug"}
      }
    },
    "responses": {
      "Failure": {
        "description": "Public error. Application status mappings and transport failures are defined in web-api.md. Raw causes, Docker output, host paths and recovered flags remain private.",
        "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}
      }
    },
    "schemas": {
      "Slug": {"type": "string", "minLength": 1, "maxLength": 40, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
      "Kind": {"type": "string", "enum": ["file", "service"]},
      "Difficulty": {"type": "integer", "minimum": 1, "maximum": 5, "description": "1 Intro, 2 Easy, 3 Medium, 4 Hard, 5 Expert. Absent for unrated legacy catalogs."},
      "FileID": {"type": "string", "pattern": "^[a-f0-9]{64}$", "minLength": 64, "maxLength": 64},
      "ProblemFile": {
        "type": "object", "additionalProperties": false, "required": ["id", "name", "size"],
        "properties": {"id": {"$ref": "#/components/schemas/FileID"}, "name": {"type": "string"}, "size": {"type": "integer", "minimum": 0}}
      },
      "ProblemDetail": {
        "type": "object", "additionalProperties": false,
        "required": ["slug", "title", "category", "kind", "description", "files", "hint_count", "walkthrough", "tools"],
        "properties": {
          "slug": {"$ref": "#/components/schemas/Slug"}, "title": {"type": "string", "minLength": 1}, "category": {"type": "string"},
          "kind": {"$ref": "#/components/schemas/Kind"}, "description": {"type": "string"},
          "difficulty": {"$ref": "#/components/schemas/Difficulty"},
          "solved_at": {"type": "string", "format": "date-time"},
          "answer": {"type": "string", "description": "Previously accepted input; present only for a completed problem."},
          "tools": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"enum": ["web", "files", "terminal"]}},
          "files": {"type": "array", "items": {"$ref": "#/components/schemas/ProblemFile"}},
          "hint_count": {"type": "integer", "minimum": 0, "maximum": 10}, "walkthrough": {"type": "boolean"}
        }
      },
      "Guidance": {
        "type": "object", "additionalProperties": false, "required": ["id", "content"],
        "properties": {"id": {"type": "string", "pattern": "^(walkthrough|hint-([1-9]|10))$"}, "content": {"type": "string"}}
      },
      "Status": {
        "type": "object", "additionalProperties": false, "required": ["slug", "kind", "state", "endpoints"],
        "properties": {
          "slug": {"$ref": "#/components/schemas/Slug"}, "kind": {"$ref": "#/components/schemas/Kind"},
          "state": {"type": "string", "enum": ["ready", "stopped", "running", "unavailable"]},
          "endpoints": {"type": "array", "items": {"$ref": "#/components/schemas/Endpoint"}}
        }
      },
      "Problem": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug", "title", "category", "kind"],
        "properties": {
          "slug": {"$ref": "#/components/schemas/Slug"},
          "title": {"type": "string", "minLength": 1},
          "category": {"type": "string"},
          "kind": {"$ref": "#/components/schemas/Kind"},
          "difficulty": {"$ref": "#/components/schemas/Difficulty"},
          "solved_at": {"type": "string", "format": "date-time"}
        }
      },
      "WorkspaceList": {
        "type": "object",
        "additionalProperties": false,
        "required": ["workspaces", "limit", "idle_seconds"],
        "properties": {
          "limit": {"type": "integer", "const": 10},
          "idle_seconds": {"type": "integer", "const": 600},
          "workspaces": {
            "type": "array", "maxItems": 10,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["slug", "title", "connected", "expires_at"],
              "properties": {
                "slug": {"$ref": "#/components/schemas/Slug"},
                "title": {"type": "string"},
                "connected": {"type": "boolean"},
                "expires_at": {"type": ["string", "null"], "format": "date-time"}
              }
            }
          }
        }
      },
      "ProblemList": {
        "type": "object",
        "additionalProperties": false,
        "required": ["problems"],
        "properties": {"problems": {"type": "array", "items": {"$ref": "#/components/schemas/Problem"}}}
      },
      "Endpoint": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "url"],
        "properties": {"name": {"type": "string"}, "url": {"type": "string", "format": "uri"}}
      },
      "Browser": {
        "type": "object", "additionalProperties": false,
        "required": ["slug", "name", "url", "target"],
        "properties": {
          "slug": {"$ref": "#/components/schemas/Slug"},
          "name": {"type": "string"},
          "url": {"type": "string", "format": "uri", "description": "Platform-controlled wrapper on a distinct loopback port."},
          "target": {"type": "string", "format": "uri", "description": "Current published problem HTTP origin."}
        }
      },
      "Run": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug", "kind", "file_count", "endpoints"],
        "properties": {
          "slug": {"$ref": "#/components/schemas/Slug"},
          "kind": {"$ref": "#/components/schemas/Kind"},
          "file_count": {"type": "integer", "minimum": 0},
          "endpoints": {"type": "array", "items": {"$ref": "#/components/schemas/Endpoint"}}
        }
      },
      "Stop": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug"],
        "properties": {"slug": {"$ref": "#/components/schemas/Slug"}}
      },
      "SubmissionRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["flag"],
        "properties": {"flag": {"type": "string", "minLength": 1}}
      },
      "Submission": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug", "accepted"],
        "properties": {"slug": {"$ref": "#/components/schemas/Slug"}, "accepted": {"type": "boolean"}}
      },
      "ErrorResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "message"],
            "properties": {
              "code": {
                "type": "string",
                "enum": ["invalid_argument", "not_found", "already_running", "not_running", "workspace_full", "resource_limit", "terminal_busy", "workspace_busy", "incompatible_contract", "validation_failed", "setup_required", "setup_failed", "storage_failed", "canceled", "deadline_exceeded", "execution_failed", "cleanup_failed", "internal_error", "invalid_request", "unauthorized", "forbidden", "method_not_allowed", "payload_too_large", "unsupported_media_type"]
              },
              "message": {"type": "string"},
              "operation": {"type": "string"},
              "slug": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
