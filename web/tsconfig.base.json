{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "allowArbitraryExtensions": true,
    "noEmit": true,
    "skipLibCheck": false,
    "types": [],
    "lib": ["ES2023"]
  }
}
