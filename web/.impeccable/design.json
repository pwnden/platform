  "narrative": {
    "northStar": "Hacker Terminal Workspace",
    "overview": "Blue-tinted black surfaces and restrained blue light give the player a working terminal character. Pretendard supports readable Korean body text and controls, while code and terminal output retain monospace typography. The workspace fills the browser viewport, with reading and execution surfaces divided by thin borders.",
    "keyCharacteristics": [
      "Subtly luminous dark blue on blue-tinted black.",
      "Pretendard for reading and controls; bundled monospace for code, terminal output and the brand.",
      "Full-width workspace with compact framing and bounded terminal geometry.",
      "State expressed through labels, tonal changes and visible keyboard focus."
    ],
    "rules": [
      { "name": "The Blue Action Rule", "body": "Use the accent, its dark fill and the active stroke together for primary and selected controls.", "section": "colors" },
      { "name": "The Reading Rule", "body": "Body text, headings and controls use Pretendard. Code, terminal output and the brand use the monospace stack.", "section": "typography" },
      { "name": "The Bounded Terminal Rule", "body": "Keep terminal measurement inside a positioned, bounded viewport. The terminal screen can shrink to (6rem) on short desktop windows.", "section": "layout" }
    ],
    "dos": [
      "Do use shared color, spacing and corner tokens for controls and panels.",
      "Do use the same padding inset on all four sides and gap between siblings.",
      "Do use Pretendard for reading and controls, and bundled monospace for code, terminal output and the brand.",
      "Do keep input borders visible at rest and provide the shared keyboard focus outline.",
      "Do preserve the full viewport layout and bounded terminal screen when adapting widths.",
      "Do pair status colors with meaningful labels derived from actual state.",
      "Do honor reduced-motion preferences for CSS animation and transitions."
