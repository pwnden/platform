FROM node:24.21.0-bookworm-slim@sha256:0e0ff40c39bc087845bfb27465a0df4ea419520094bc35842ff83dd8cbe6f9b6 AS verify
WORKDIR /web
RUN npm install --global --no-audit --no-fund pnpm@12.8.1
COPY web/ ./
COPY internal/httpapi/browser-controller.js /internal/httpapi/browser-controller.js
RUN pnpm install --frozen-lockfile
RUN pnpm verify

FROM scratch AS assets
COPY --from=verify /web/dist/player/ /
